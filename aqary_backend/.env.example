# Server
PORT=3000
NODE_ENV=development

# PostgreSQL (Amazon RDS, Bahrain region — me-south-1)
DATABASE_URL=postgresql://user:password@localhost:5432/aqary
DATABASE_SSL=false

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=1h

# AWS S3 — separate buckets per the Full Architecture Plan, Section 8.1
AWS_REGION=me-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_MEDIA=aqary-property-media
S3_BUCKET_DOCUMENTS=aqary-verification-docs

# Password reset links point here (your Flutter app's deep link or a web fallback)
RESET_PASSWORD_BASE_URL=https://app.aqary.om/reset-password
